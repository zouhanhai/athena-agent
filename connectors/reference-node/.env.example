# Copy to .env and fill in. NEVER commit real secrets.
# Extended from onboarding: GET /api/agents/onboard?token=<inviteToken>

# Required — from the platform's onboard/invitation JSON
ATHENA_AGENT_ID=agent-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ATHENA_TOKEN=your_invite_token_here

# Optional overrides (defaults shown)
# ATHENA_WS_URL=wss://athenakb.com/ws/agent
# ATHENA_API_URL=http://127.0.0.1:8642/v1      # local answer-provider (Hermes API server etc.)
# ATHENA_API_KEY=                                # Bearer key for the answer-provider
# ATHENA_PIDFILE=/tmp/athena_ws.pid
# ATHENA_MAX_CONTEXT_TOKENS=200000               # advertised context budget (soft ceiling)