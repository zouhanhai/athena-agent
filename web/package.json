{
  "name": "athena-agent-web",
  "version": "0.1.0",
  "description": "athena-agent 前端门户 (Vue3 + TDesign)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
