{
  "name": "athena-agent-server",
  "version": "0.1.0",
  "description": "athena-agent 后端门户 (Fastify + Pi SDK 内嵌)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "verify": "tsx src/agents/verify-agent.ts",
    "logos:generate": "tsx scripts/generate-logos.ts",
    "sync:github": "npm run sync:github --prefix ../gdd",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit \"test/**/*.test.ts\"",
    "test:docling": "~/docling-venv/bin/python test/parse_doc_test.py"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@fastify/multipart": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "fastify": "^5.11.2",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.0",
    "typebox": "^1.3.7",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
