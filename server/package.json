{
  "name": "athena-agent-server",
  "version": "0.1.0",
  "description": "athena-agent 后端门户 (Fastify + Pi SDK 内嵌)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "verify": "tsx src/agents/verify-agent.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "fastify": "^5.11.2",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
