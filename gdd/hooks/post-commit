#!/usr/bin/env bash
# post-commit hook — md → GitHub auto-sync on new board file commits (G4.S5.T15).
#
# When a commit adds/modifies new docs/kanban Goal/Spec/Ticket md files, run
# sync-github create for each affected Spec so the GitHub Project board reflects
# the full kanban (incl. backlog) from the start. Best-effort: a sync failure is
# logged to a temp file and never blocks the commit.
#
# Ships with the gdd/ package (G4.S6.T3). Installed via `gdd/hooks/
# install-kanban-hook.sh` (sets git core.hooksPath → hooks/). The sync runs the
# gdd CLI standalone on the USER's machine with a LOCAL GitHub credential:
# `gh auth token` (gh CLI) → `GITHUB_TOKEN` env → the athena employee store only
# as an optional fallback when running inside athena (DATABASE_URL).
set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -z "$REPO_ROOT" ] && exit 0
cd "$REPO_ROOT" || exit 0

LOG="$HOME/.athena-tmp/kanban-hook.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null

# Determine the files added/modified in this commit under docs/kanban.
CHANGED="$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | grep -E '^docs/kanban/(G[0-9]+/S[0-9]+/)?(Goal\.md|Spec\.md|T[0-9]+\.md)$' || true)"
[ -z "$CHANGED" ] && exit 0

# Collect affected Spec refs: from Spec.md / T*.md paths, and new Goals' specs.
SPECS=""
for f in $CHANGED; do
  case "$f" in
    *T*.md|*Spec.md)
      # docs/kanban/G4/S5/T1.md → G4.S5 ; docs/kanban/G4/S5/Spec.md → G4.S5
      rel="${f#docs/kanban/}"; dir="${rel%/*}"            # G4/S5
      spec="$(echo "$dir" | tr '/' '.')"                   # G4.S5
      case "$spec" in
        G[0-9]*.S[0-9]*) SPECS="$SPECS $spec" ;;
      esac
      ;;
    *) : ;; # Goal.md has no spec ref of its own; its specs are created later
  esac
done

# De-dupe and run sync-github create for each spec.
# Resolve owner/repo from the PRIMARY remote — caleo (team/primary repo) is
# preferred; fall back to origin (zouhanhai shadow). Supports BOTH HTTPS
# (https://github.com/OWNER/REPO.git) and SSH (git@github.com:OWNER/REPO.git)
# URLs. The hook env has no GITHUB_OWNER/GITHUB_REPO, so guess-free derivation
# avoids empty/malformed --owner (the SSH form was mangling owner to
# "git@github.com:owner").
# (2026-08-14: caleo is the primary repo, zouhanhai is the shadow.)
for REMOTE_NAME in caleo origin; do
  ORIGIN_URL="$(git -C "$REPO_ROOT" remote get-url "$REMOTE_NAME" 2>/dev/null || true)"
  [ -n "$ORIGIN_URL" ] && break
done
GH_OWNER=""
GH_REPO=""
case "$ORIGIN_URL" in
  *github.com*|*github.com:*)
    url="${ORIGIN_URL%.git}"
    url="${url##*github.com[/:]}"
    GH_OWNER="${url%%/*}"
    GH_REPO="${url#*/}"
    ;;
esac
if [ -z "$GH_OWNER" ] || [ -z "$GH_REPO" ] || [ "$GH_OWNER" = "git@" ]; then
  echo "$(date '+%Y-%m-%d %H:%M:%S') kanban-hook: cannot derive owner/repo from origin ($ORIGIN_URL) — skipping" >> "$LOG"
  exit 0
fi

SEEN=""
for spec in $SPECS; do
  case " $SEEN " in *" $spec "*) continue ;; esac
  SEEN="$SEEN $spec"
  echo "$(date '+%Y-%m-%d %H:%M:%S') kanban-hook: sync $spec ($GH_OWNER/$GH_REPO)" >> "$LOG"
  (
    cd "$REPO_ROOT/gdd" || exit 1
    # Local credential: `gh auth token` (gh CLI) or GITHUB_TOKEN; the athena
    # employee store is only an optional fallback when running inside athena.
    # Machine-specific fallbacks live in gdd/hooks/sync.env (gitignored) so the
    # shipped hook stays project-neutral — no personal tokens/URLs in git.
    if [ -f "$REPO_ROOT/gdd/hooks/sync.env" ]; then
      set -a; . "$REPO_ROOT/gdd/hooks/sync.env"; set +a
    fi
    if [ -f "$REPO_ROOT/server/.env.local" ]; then set -a; . "$REPO_ROOT/server/.env.local"; set +a; fi
    npx tsx src/sync-github.ts create "$spec" --owner "$GH_OWNER" --repo "$GH_REPO"
  ) >> "$LOG" 2>&1 || echo "kanban-hook: sync $spec FAILED (see $LOG)" >> "$LOG"
done

exit 0
